# --- Entorno ---
APP_ENV=dev                                  
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173      
PUBLIC_CHAT_BASE_URL=https://soporte.tudominio.com   
CORS_ORIGINS=["http://localhost:5173"]       

# --- Base de datos y caché ---
# Con `docker compose` estas dos se arman solas (ver docker-compose.yml); defínelas si no usas Docker.
# DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot
# REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=chatbot

# --- Primer arranque: superadministrador (python -m app.cli seed) ---
SUPERADMIN_EMAIL=admin@tudominio.com
SUPERADMIN_NAME=Superadministrador
SUPERADMIN_PASSWORD=cambia-esta-clave

# --- Solo desarrollo (python -m app.cli seed --demo; bloqueado si APP_ENV=prod) ---
DEMO_COMPANY_ADMIN_EMAIL=adminempresa@demo.com
DEMO_AGENT_EMAIL=trabajadorconsola@demo.com
DEMO_PASSWORD=cambia-esta-clave

# --- Tokens de sesión (JWT) ---
# OBLIGATORIO en producción: si se dejan vacías, se genera una clave nueva en cada arranque
# y todas las sesiones se cierran con cada despliegue.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

# --- Correo (invitaciones y restablecimiento de contraseña) ---
EMAIL_BACKEND=console                        
EMAIL_FROM=no-reply@tudominio.com            
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# --- Marca y valores por defecto de cada empresa nueva ---
PRODUCT_NAME="Chatbot de Soporte"
BRAND_COLOR=#00a79d
DEFAULT_TIMEZONE=America/Santiago

# --- Plazos y límites (opcionales; valores por defecto entre paréntesis) ---
# INVITATION_DAYS=7
# RESET_TOKEN_HOURS=1
# TENANT_PURGE_DAYS=90
# RESET_REQUESTS_PER_HOUR=3
# RESEND_INVITATION_PER_HOUR=3
# MANUAL_SCANS_PER_HOUR=1
# SESSIONS_PER_IP_PER_HOUR=20
# PUBLIC_MSG_PER_MINUTE=20
# MAX_DOCUMENT_MB=25
# DEFAULT_TOKEN_LIMIT_MONTH=1000000

# --- Umbrales del bot (opcionales) ---
# CLASSIFIER_CONFIDENCE_THRESHOLD=0.6
# CHAT_HISTORY_TURNS=3
# CRAWLER_MAX_PAGES=150
# SUGGESTION_COVERED_SIMILARITY=0.86
# SUGGESTION_GROUP_SIMILARITY=0.80
# FAQ_DUPLICATE_SIMILARITY=0.92

# --- Almacenamiento, IA y canales (opcionales) ---
# STORAGE_BACKEND=local                      
# EMBEDDINGS_BACKEND=hash                    
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

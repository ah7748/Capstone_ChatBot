# ===== Chatbot de Soporte Genérico · Backend · variables de entorno =====

# --- Aplicación ---
APP_ENV=dev                          # dev | staging | prod
API_BASE_URL=http://localhost:8000
PUBLIC_CHAT_BASE_URL=https://soporte.allox.ai
CORS_ORIGINS=["http://localhost:5173"]

# --- Base de datos (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot

# --- Redis (colas arq, rate limit, pub/sub tiempo real) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT (RS256). Si se dejan vacíos en dev, se generan claves efímeras al arrancar ---
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
SESSION_TOKEN_HOURS=24

# --- Secretos: env (dev) o keyvault (Azure) ---
SECRETS_BACKEND=env                  # env | keyvault
AZURE_KEY_VAULT_URL=                 # https://<vault>.vault.azure.net (si keyvault)

# --- Almacenamiento de documentos: local (dev) o azure_blob ---
STORAGE_BACKEND=local                # local | azure_blob
LOCAL_STORAGE_DIR=./var/storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documents

# --- DeepSeek ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# --- Embeddings: azure_openai (real) o hash (dev/test determinista) ---
EMBEDDINGS_BACKEND=hash              # azure_openai | hash
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIM=1536

# --- WhatsApp (Meta Cloud API) ---
META_GRAPH_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_VERIFY_TOKEN=cambia-este-verify-token
WHATSAPP_APP_SECRET=

# --- Workers ---
WORKERS_INLINE=true                  # true en dev/test: ejecuta tareas en el proceso; false: encola en arq

# --- Límites ---
MAX_DOCUMENT_MB=25
PUBLIC_MSG_PER_MINUTE=20
DEFAULT_TOKEN_LIMIT_MONTH=1000000
